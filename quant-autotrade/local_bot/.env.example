# 이 파일을 .env 로 복사해 값을 직접 입력합니다(값은 채팅·문서·코드에 붙여 넣지 마세요).
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 비워 두면 기록 전용(DRY). true 로 바꾸면 실제 매도 주문이 나갑니다.
LIVE_SELL=
# 모의투자 확인용(선택)
# KIWOOM_BASE_URL=https://mockapi.kiwoom.com
# 연구 후보 생성기 모의 키(선택, 읽기 전용 실측 도구 probe 용)
# KIWOOM_MOCK_APPKEY=
# KIWOOM_MOCK_SECRETKEY=

# 텔레그램 관제(알림·읽기 전용 명령). 값은 telegram_setup.bat 이 이 파일에 직접 써 줍니다 - 채팅·문서에 붙여 넣지 마세요.
# TELEGRAM_BOT_TOKEN      BotFather 가 준 봇 토큰
# TELEGRAM_ALLOWED_USER_ID 허용할 본인의 텔레그램 사용자 ID(숫자). 페어링 코드로 자동 입력됩니다
# TELEGRAM_CHAT_ID        알림을 받을 개인 채팅 ID(숫자, 개인 채팅이면 위 값과 같음). 그룹·채널 ID(음수)는 거부됩니다
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_CHAT_ID=
